#!/usr/bin/env node
import { join } from 'node:path';
import { pathToFileURL } from 'node:url';
import { checkout } from '../codex/checkout.mjs';

try {
  const { main } = await import(pathToFileURL(join(checkout(), 'codex/run.mjs')));
  await main();
} catch (error) {
  console.error(error.message);
  process.exitCode = 1;
}
